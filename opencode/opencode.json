{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@5.1.65",
    "opencode-codebase-index@0.38.2",
    "@warp-dot-dev/opencode-warp@0.1.7"
  ],
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ]
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--no-sandbox",
        "--browser",
        "chromium",
        "--viewport-size",
        "1280x720",
        "--image-responses",
        "omit"
      ]
    }
  },
  "model": "github-copilot/gpt-6.1-sol",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "description": "Read-only planning agent for project inspection, migration planning, risk analysis, and validation strategy.",
      "model": "github-copilot/gpt-6.1-sol",
      "prompt": "You are the planning agent. Read AGENTS.md first and treat it as authoritative. Inspect the project, identify risks, propose small steps, and recommend validation commands. For project memory, do not validate memory content quality yourself. Only detect whether required memory files exist. If any required memory file is missing, delegate memory initialization/updates to the project-architecture-memory-writer skill. Do not modify files, apply patches, run mutating commands, commit, push, or change external systems. If execution is needed, hand off a concise plan to the build agent.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "external_directory": "ask",
        "webfetch": "ask",
        "websearch": "ask"
      }
    },
    "build": {
      "mode": "primary",
      "description": "Execution agent for approved implementation, validation, commits, and operational commands.",
      "model": "github-copilot/gpt-6.1-sol",
      "prompt": "You are the execution agent. Read AGENTS.md first and treat it as authoritative. Implement the requested change or the approved plan in small, reviewable steps. Prefer existing project patterns, run the narrowest useful validation, report failures clearly, and keep risky operations such as commits, pushes, destructive commands, credentials, production writes, and external side effects explicit and reviewable. Before implementation, load git-commit and plan small verified checkpoints. Commit only when authorized for the task.",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "external_directory": "ask",
        "webfetch": "ask",
        "websearch": "ask"
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B Fast Chat",
          "tools": true,
          "options": {
            "num_ctx": 8192,
            "temperature": 0.2
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B",
          "tools": true,
          "options": {
            "num_ctx": 8192,
            "temperature": 0.1
          }
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B",
          "tools": true,
          "options": {
            "num_ctx": 32768,
            "temperature": 0.1
          }
        },
        "deepseek-r1:32b": {
          "name": "DeepSeek R1 32B",
          "tools": true,
          "options": {
            "num_ctx": 32768,
            "temperature": 0.1
          }
        },
        "deepseek-coder:33b": {
          "name": "DeepSeek Coder 33B",
          "tools": true,
          "options": {
            "num_ctx": 32768,
            "temperature": 0.1
          }
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B Fast Chat",
          "tools": true,
          "options": {
            "num_ctx": 8192,
            "temperature": 0.2
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI / ChatGPT",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "tools": true
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "tools": true
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "tools": true
        }
      }
    }
  },
  "small_model": "github-copilot/gpt-6-luna"
}
